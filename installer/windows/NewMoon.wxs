<?xml version="1.0" encoding="UTF-8"?>
<!--
  Standard Windows Installer (MSI) definition for New Moon (x64).
  Uses a clean, uncompressed MSI package (no UPX packing or custom SFX stubs)
  to minimize Windows Defender false positives.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="New Moon (WebGPU Edition)"
           Manufacturer="barefacedstorm"
           Version="35.1.0.0"
           UpgradeCode="B8F4C2A1-7D3E-4E9B-9A21-6C5E8F12D401"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of New Moon is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="mszip" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="New Moon" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="New Moon" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="ProductFeature" Title="New Moon Browser" Level="1">
      <ComponentGroupRef Id="NewMoonFiles" />
      <ComponentRef Id="ApplicationShortcuts" />
    </Feature>

    <Component Id="ApplicationShortcuts" Directory="ApplicationProgramsFolder" Guid="A3C7E912-4F55-4B8A-8D11-3E7A9F02C184">
      <Shortcut Id="StartMenuShortcut"
                Name="New Moon"
                Description="New Moon WebGPU Browser"
                Target="[INSTALLFOLDER]palemoon.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="DesktopShortcut"
                Directory="DesktopFolder"
                Name="New Moon"
                Description="New Moon WebGPU Browser"
                Target="[INSTALLFOLDER]palemoon.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\barefacedstorm\NewMoon" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
