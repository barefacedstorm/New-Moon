EXPORTS.webgpu += [
    'include/webgpu/webgpu.h',
    'include/webgpu/wgpu.h',
]

EXPORTS.mozilla.dom += [
    'WebGPU.h',
]

UNIFIED_SOURCES += [
    'GPUCanvasContext.cpp',
    'WebGPU.cpp',
]

LOCAL_INCLUDES += [
    '/dom/base',
    '/dom/canvas',
    '/dom/html',
    '/gfx/2d',
    '/gfx/layers',
    '/image',
    'include',
]

FINAL_LIBRARY = 'xul'

if CONFIG['GNU_CXX']:
    CXXFLAGS += ['-Wno-error=shadow']
